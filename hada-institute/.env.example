# --- Database (Supabase Postgres) ---
# Use the Supabase Project Settings -> Database -> Connection string.
# IMPORTANT: Supabase requires SSL. Your final DATABASE_URL must include:
#   sslmode=require
# Example format:
# postgresql://USER:PASSWORD@db.example.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require"

# --- NextAuth ---
NEXTAUTH_SECRET="<generate-a-random-string>"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="<google-client-id>"
GOOGLE_CLIENT_SECRET="<google-client-secret>"

# --- NextAuth / Google redirect envs (only if used) ---
NEXTAUTH_URL="http://localhost:3000" # change on Vercel to https://your-domain.vercel.app

# --- Razorpay ---
RAZORPAY_KEY_ID="<razorpay-key-id>"
RAZORPAY_KEY_SECRET="<razorpay-key-secret>"
NEXT_PUBLIC_RAZORPAY_KEY_ID="<razorpay-key-id>" # used client-side

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME="<cloudinary-cloud-name>"
CLOUDINARY_API_KEY="<cloudinary-api-key>"
CLOUDINARY_API_SECRET="<cloudinary-api-secret>"

